        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000125"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand upright with feet shoulder width apart. Action: Slowly bend knees until the thighs are parallel to the floor, then slowly straighten knees back to the start position. Variations: sliding up and down the wall; adding hand weights; varying the trunk angle; varying the feet positioning; adding calf raises when rising from the squat; on an uneven or unstable surface; throwing a ball at a target; adding upper body movements.</obo:IAO_0000115>
        <obo:UMLS_TUI_T155 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000056"/>
        <obo:UMLS_TUI_T155 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000061"/>
