    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001188 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001188">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001003"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001003"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An excessive tilt of patella toward the outside (lateral) aspect of the knee joint.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
