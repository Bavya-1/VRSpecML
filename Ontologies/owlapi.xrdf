    <!-- http://purl.obolibrary.org/obo/TRAK_0000271 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000271">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000270"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000270"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Improvements in patient motivation could be brought about by the therapist adopting specific qualities and modes of behaviour towards patients. These are: a constantly positive and encouraging attitude towards the patient; a willingness to empower patients to become actively involved in the management of their rehabilitation programmes; and the ability to instil instrumental rationality (the ability to select appropriate means to achieve a given end) in the patient.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0557964</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000271</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">motivating patient</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000271</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000271"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Improvements in patient motivation could be brought about by the therapist adopting specific qualities and modes of behaviour towards patients. These are: a constantly positive and encouraging attitude towards the patient; a willingness to empower patients to become actively involved in the management of their rehabilitation programmes; and the ability to instil instrumental rationality (the ability to select appropriate means to achieve a given end) in the patient.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:10641802</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000272 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000272">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000270"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000270"/>
