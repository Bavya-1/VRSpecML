        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">articular cartilage</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000043</skos:notation>
