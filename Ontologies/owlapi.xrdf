    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000969 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000969">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000673"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000673"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In sports and particularly exercise testing, the Borg scale measures perceived exertion. In medicine this is used to document the patient&apos;s exertion during a test.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0449399</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Borg RPE scale</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RPE scale</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rating of Perceived Exertion scale</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000969</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Borg scale</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000969</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000969"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In sports and particularly exercise testing, the Borg scale measures perceived exertion. In medicine this is used to document the patient&apos;s exertion during a test.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Borg_scale</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000970 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000970">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000969"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000969"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The original scale introduced by Gunnar Borg rated exertion on a scale of 6-20. The seemingly odd range of 6-20 is to follow the general heart rate of a healthy adult by multiplying by 10. For instance, a perceived exertion of 12 would be expected to coincide with a heart rate of roughly 120 beats per minute.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000970</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">15 point Borg scale</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000970</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000970"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The original scale introduced by Gunnar Borg rated exertion on a scale of 6-20. The seemingly odd range of 6-20 is to follow the general heart rate of a healthy adult by multiplying by 10. For instance, a perceived exertion of 12 would be expected to coincide with a heart rate of roughly 120 beats per minute.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Borg_scale</oboInOwl:hasDbXref>
    </owl:Axiom>
    


