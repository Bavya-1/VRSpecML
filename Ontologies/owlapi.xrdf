    <!-- http://purl.obolibrary.org/obo/TRAK_0000113 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000112"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000112"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cryocuff treatment uses a device that circulates ice cold water to provide cold therapy in the treatment of injuries.</obo:IAO_0000115>
