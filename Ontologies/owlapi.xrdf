        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001293"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0231740</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000458</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Apley distraction test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000458</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000459 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000459">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000542"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for a meniscal injury. The patient is prone with the knee flexed at 90 degrees. The examiner grasps the foot with both hands and externally rotates it as far as possible while pushing down though the tibia. When this limit is reached, the examiner rotates the foot internally. Increased pain during rotation indicates a positive test.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000542"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0231750</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Apley compression test</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Apley grinding test</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000459</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Apley grind test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000459</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000460 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000460">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000542"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the patient lying flat, the knee is first fully flexed; the foot is held by grasping the heel. The leg is rotated on the thigh with the knee still in full flexion. By altering the position of flexion, the whole of the posterior segment of the cartilages can be examined from the middle to their posterior attachment. Bring the leg from its position of acute flexion to a right angle while the foot is retained first in full internal rotation and then in full external rotation. When the click occurs (in association with a torn meniscus), the patient is able to state that the sensation is the same as he/she experienced when the knee gave way previously.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000542"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0231755</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000460</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">McMurray test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000460</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000460"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">With the patient lying flat, the knee is first fully flexed; the foot is held by grasping the heel. The leg is rotated on the thigh with the knee still in full flexion. By altering the position of flexion, the whole of the posterior segment of the cartilages can be examined from the middle to their posterior attachment. Bring the leg from its position of acute flexion to a right angle while the foot is retained first in full internal rotation and then in full external rotation. When the click occurs (in association with a torn meniscus), the patient is able to state that the sensation is the same as he/she experienced when the knee gave way previously.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:12690600</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000462 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000462">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000542"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The test is performed with the patient supine and the foot cupped in the examiner&apos;s hand. With the patient&apos;s knee completely flexed, the knee is passively allowed to extend. The knee should extend completely or bounce home into extension with a sharp endpoint. If extension is not complete or has a rubbery end feel, there is probably a torn meniscus or some other blockage.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000542"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0231743</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000462</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">bounce home test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000462</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000462"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The test is performed with the patient supine and the foot cupped in the examiner&apos;s hand. With the patient&apos;s knee completely flexed, the knee is passively allowed to extend. The knee should extend completely or bounce home into extension with a sharp endpoint. If extension is not complete or has a rubbery end feel, there is probably a torn meniscus or some other blockage.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:12690600</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000463 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000463">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000409"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000409"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A continuant that inheres in continuant entities and is not exhibited in full at every time in which it inheres in an entity or group of entities. The exhibition or actualization of a realizable entity is a particular manifestation, functioning or process that occurs under certain circumstances.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BFO:snap:RealizableEntity</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000463</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">realizable entity</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000463</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000463"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A continuant that inheres in continuant entities and is not exhibited in full at every time in which it inheres in an entity or group of entities. The exhibition or actualization of a realizable entity is a particular manifestation, functioning or process that occurs under certain circumstances.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">BFO:snap:RealizableEntity</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000464 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000464">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000223"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for chondromalacia patellae. The patient is seated with the femur externally rotated and knee flexed to 120 degrees. The patient then performs a 10-second isometric contraction. If pain is experienced during the contraction, the knee is passively extended and then a medial glide applied to the patella. The knee is returned to the position that caused pain, and the patient again performs an isometric contraction while the medial patella glide is maintained. If the pain experienced is decreased, chondromalacia patellae is suspected. The test is repeated with the knee at various flexion angles.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000223"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C2110571</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000464</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">McConnell test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000464</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000465 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000465">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000542"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for a meniscal injury or capsular irritation. The patient is prone. The examiner flexes the knee to 90 degrees, rotates the tibia internally and externally twice, and then fully extends the knee. The process is repeated. Increased pain during rotation indicates a positive test.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000542"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C2176322</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000465</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O&apos;Donoghue test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000465</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000466 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000466">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000550"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for patellar dislocation. The subject is supine and relaxed. The examiner pushes the patella as lateral as possible. Then the examiner flexes the knee flexed to 30 degrees and sustains the lateral glide. The subject&apos;s apprehension indicates a positive test.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000550"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C2110455</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fairbank test</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000466</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">patellar apprehension test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000466</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000466"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for patellar dislocation. The subject is supine and relaxed. The examiner pushes the patella as lateral as possible. Then the examiner flexes the knee flexed to 30 degrees and sustains the lateral glide. The subject&apos;s apprehension indicates a positive test.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:15950517</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000467 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000467">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000226"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test used to detect the presence of Osteochondritis dissecans of the knee. The patient is sitting on a table with legs dangling over the edge. The examiner bends the patient&apos;s knee so that it is flexed at a 90 degrees angle, then grasps the patient&apos;s foot and brings the tibia in (internal rotation). The patient is asked to extend the leg until the pain is felt. The test is positive if the patient reports pain in the knee about 30 degrees from full extension and when by rotating the foot back (external rotation of the tibia) in its normal position the pain disappears.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000226"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C2110468</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000467</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wilson test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000467</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000467"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test used to detect the presence of Osteochondritis dissecans of the knee. The patient is sitting on a table with legs dangling over the edge. The examiner bends the patient&apos;s knee so that it is flexed at a 90 degrees angle, then grasps the patient&apos;s foot and brings the tibia in (internal rotation). The patient is asked to extend the leg until the pain is felt. The test is positive if the patient reports pain in the knee about 30 degrees from full extension and when by rotating the foot back (external rotation of the tibia) in its normal position the pain disappears.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physiopedia:Wilson&apos;s_Test</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000468 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000468">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000445"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A provocative test of the iliotibial band. It is commonly used as an indication for iliotibial band syndrome. The subject is supine. Bring the affected knee up to a 90 degree flexion and apply pressure with a thumb to the lateral femoral epicondyle. Afterwards the leg is extended slowly. When it is extended at approximately 30 degrees, the iliotibial band translates anteriorly over the lateral femoral epicondyle under the examiners thumb. If the patient indicates pain at this 30 degree angle, which is similar to when the patient is active, then the test is positive.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000445"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C2110471</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Noble compression test</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000468</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Noble test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000468</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000468"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A provocative test of the iliotibial band. It is commonly used as an indication for iliotibial band syndrome. The subject is supine. Bring the affected knee up to a 90 degree flexion and apply pressure with a thumb to the lateral femoral epicondyle. Afterwards the leg is extended slowly. When it is extended at approximately 30 degrees, the iliotibial band translates anteriorly over the lateral femoral epicondyle under the examiners thumb. If the patient indicates pain at this 30 degree angle, which is similar to when the patient is active, then the test is positive.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physiopedia:Noble&apos;s_test</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000469 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000469">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000542"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The patient is supine. The knee is held flexed at 90 degrees and forced to external rotation, then internal rotation. The test is positive for medial meniscal tear if raises pain upon externally rotating, while it is positive for lateral meniscal tears in case of pain during internal rotation.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000542"/>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Steinmann I sign</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000469</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Steinmann first test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000469</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000469"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The patient is supine. The knee is held flexed at 90 degrees and forced to external rotation, then internal rotation. The test is positive for medial meniscal tear if raises pain upon externally rotating, while it is positive for lateral meniscal tears in case of pain during internal rotation.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:22035381</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000470 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000470">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000231"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A two-phase test for patellofemoral pain syndrome. For phase I, the subject is supine and the examiner presses the patella against the femur while simultaneously performing a passive knee flexion with the other hand. Crepitus and pain during a particular part of the range of motion are considered signs of patellofemoral pain disorders. For phase II, the subject is standing and asked to perform a slow, full squat, again with the examiner performing a gentle compression of the patella against the femur. Crepitus and pain indicate a positive test.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000231"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C2110585</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000470</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Waldron test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000470</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000470"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A two-phase test for patellofemoral pain syndrome. For phase I, the subject is supine and the examiner presses the patella against the femur while simultaneously performing a passive knee flexion with the other hand. Crepitus and pain during a particular part of the range of motion are considered signs of patellofemoral pain disorders. For phase II, the subject is standing and asked to perform a slow, full squat, again with the examiner performing a gentle compression of the patella against the femur. Crepitus and pain indicate a positive test.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:15950517</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000471 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000471">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000511"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000557"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001299"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Leg picked up at the ankle; the knee is flexed by placing the heel of the hand behind the fibula. As the knee is extended, the tibia is supported on the lateral side with a slight valgus strain. A strong valgus force is placed on the knee by the upper hand. At approximately 30 degrees of flexion, the displaced tibia will suddenly reduce, indicating a positive pivot shift test.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000511"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000557"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001299"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0576171</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000471</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pivot shift test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000471</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000471"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Leg picked up at the ankle; the knee is flexed by placing the heel of the hand behind the fibula. As the knee is extended, the tibia is supported on the lateral side with a slight valgus strain. A strong valgus force is placed on the knee by the upper hand. At approximately 30 degrees of flexion, the displaced tibia will suddenly reduce, indicating a positive pivot shift test.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:12690600</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000472 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000472">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000516"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000558"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001297"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for posterolateral rotary instability. The patient lies supine with their knee flexed to between 45 and 60 degrees and their foot externally rotated. The examiner applies a valgus force while slowly extending the knee. A clunk will be felt around 30 degrees of knee flexion if the subluxed or dislocated joint has reduced. Boh knees are always tested for comparison in order to avoid false positives.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000516"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000558"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001297"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0430756</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jakob test</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000472</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reverse pivot shift test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000472</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000472"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for posterolateral rotary instability. The patient lies supine with their knee flexed to between 45 and 60 degrees and their foot externally rotated. The examiner applies a valgus force while slowly extending the knee. A clunk will be felt around 30 degrees of knee flexion if the subluxed or dislocated joint has reduced. Boh knees are always tested for comparison in order to avoid false positives.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Posterolateral_knee_injuries</oboInOwl:hasDbXref>
    </owl:Axiom>
    


