        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">collateral ligament</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001127</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001127"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A ligament located on either side of a hinge joint such as the knee or wrist that acts as a radius of movement for the joint.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MedicalDictionary:collateral+ligament</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001128 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001128">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000090"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000090"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anatomical structure, which has as its direct parts instances of one or more organ types which are interconnected with one another by zones of continuity. Examples: skeletal system, cardiovascular system, alimentary system.</obo:IAO_0000115>
