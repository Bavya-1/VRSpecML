        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000134"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand upright with feet shoulder width apart. Action: Without using hands bend the knees, hips and trunk to lower down towards the chair. Before sitting down rise back to the start position. Repeat.</obo:IAO_0000115>
