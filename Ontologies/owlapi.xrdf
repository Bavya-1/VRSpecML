    <!-- http://purl.obolibrary.org/obo/TRAK_0000302 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000302">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000138"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000138"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand with equal body weight on both legs. Action: Shift the body weight onto the affected leg, hold and then return to the start position. Shift the body weight onto the unaffected leg, hold and then return to the start position.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C2147945</oboInOwl:hasDbXref>
