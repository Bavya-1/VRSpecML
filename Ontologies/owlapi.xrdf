        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hopping for distance</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000416</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000417 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000417">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000141"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000141"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand on the affected leg. Action: Bend the affected knee, hop diagonally and land keeping balance on the affected leg. Hop diagonally in the other direction. Variations: catching and throwing a ball; increasing hop distance; performing on an uneven surface; increasing hop speed.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000417</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">crossover hopping</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000417</skos:notation>
    </owl:Class>
    


