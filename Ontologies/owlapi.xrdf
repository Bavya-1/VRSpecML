                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000158"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000135"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand upright. Action: Step backwards with the affected leg and bend the affected knee until it is flexed 90 degrees, then slowly straighten up keeping the body weight on the affected leg and step back with the unaffected leg.</obo:IAO_0000115>
        <obo:UMLS_TUI_T188 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000157"/>
        <obo:UMLS_TUI_T188 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000158"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C2019591</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reverse lunges</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000405</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">backward lunges</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000405</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000406 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000406">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000135"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T188"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000157"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T188"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000158"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000135"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand with the affected leg forward. Action: Slowly bend the affected knee and move the body weight forward onto the affected leg until the knee is flexed 90 degrees and directly above the toes, then slowly straighten knees back to the start position. Variations: adding hand weights; varying the trunk angle; varying the feet positioning; on an uneven or unstable surface; throwing a ball at a target; adding upper body movements; adding elastic resistance.</obo:IAO_0000115>
        <obo:UMLS_TUI_T188 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000157"/>
        <obo:UMLS_TUI_T188 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000158"/>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000406</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">forward lunges</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000406</skos:notation>
    </owl:Class>
    


