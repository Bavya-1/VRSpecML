        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000152"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Lie down on the side with the affected side uppermost and knees bent to 90 degrees. Rotate the affected knee upwards as far as possible without moving pelvis. Return to the start position. Variations: lifting the uppermost leg so the feet are slightly apart.</obo:IAO_0000115>
