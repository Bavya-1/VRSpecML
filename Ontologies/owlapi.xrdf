        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lifestyle therapy</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001203</skos:notation>
    </owl:Class>
