        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000102"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A system of diagnosis and treatment first described by Andrew Taylor Still and his early students, which engages continual palpatory feedback to achieve release of myofascial tissues.</obo:IAO_0000115>
        <TRAK:performed_on rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001072"/>
        <TRAK:performed_on rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001148"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0695600</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
