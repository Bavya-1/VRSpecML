        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000138"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000138"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Balance on the affected leg. Action: Maintain balance on the affected leg, shut eyes and keep balance without using your arms or the unaffected leg for support. Variations: standing on an uneven or unstable surface.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000412</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">single leg balance with closed eyes</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000412</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000413 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000413">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000141"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000141"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand on the affected leg. Action: Bend the affected knee, hop upwards, land and keep your balance on the affected leg. Variations: on an uneven or unstable surface; catching and throwing a ball, increasing hop height; increasing knee bend.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000413</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vertical hopping</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000413</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000414 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000414">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000141"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000141"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand on the affected leg. Action: Slightly bend the affected knee and hop to the side landing on the same leg allowing the knee to bend. Keep the balance and hop back to the start position. Variations: catching and throwing a ball; Increasing the hopping distance.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">one legged lateral hopping</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">one legged sideways hopping</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">single leg sideways hopping</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000414</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">single leg lateral hopping</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000414</skos:notation>
    </owl:Class>
    


