        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C2721273</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000179 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000179">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000166"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000166"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Exercisers designed primarily to facilitate the physical exertion of body muscles by voluntary contraction and relaxation of large muscle groups (i.e., active exercisers) that are intended primarily to provide resistance to muscular contraction for development of muscular strength and endurance. The resistance to muscular contractions may be provided by gravity using free weights or constrained weights, hydraulic resistance mechanisms, elastic resistance, or other sources.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C2721227</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000179</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">muscle strength exerciser</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000179</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000179"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Exercisers designed primarily to facilitate the physical exertion of body muscles by voluntary contraction and relaxation of large muscle groups (i.e., active exercisers) that are intended primarily to provide resistance to muscular contraction for development of muscular strength and endurance. The resistance to muscular contractions may be provided by gravity using free weights or constrained weights, hydraulic resistance mechanisms, elastic resistance, or other sources.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C2721227</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000180 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000180">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000179"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000179"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strength exercisers designed to provide elastic resistance to muscular contraction for developing muscular strength and endurance. These exercisers typically consist of an elastic material such as a flexible (e.g., rubber) band or tube or a coiled metal spring; the elastic resistance increases as the elastic element is stretched.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C2721256</oboInOwl:hasDbXref>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resistance band</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">resistance tube</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">thera-band</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000180</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">elastic resistance exerciser</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000180</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000180"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Strength exercisers designed to provide elastic resistance to muscular contraction for developing muscular strength and endurance. These exercisers typically consist of an elastic material such as a flexible (e.g., rubber) band or tube or a coiled metal spring; the elastic resistance increases as the elastic element is stretched.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C2721256</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000181 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000181">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000179"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000179"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Muscle strength exercisers designed to provide resistance to muscular contraction using unconstrained weighted plates; the resistance is provided by the force of gravity acting on the free weights. Free weights are not attached to any other devices and do not restrict the user&apos;s movements; they usually include barbells and dumbbells.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C2721764</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000181</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">free weight</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000181</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000181"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Muscle strength exercisers designed to provide resistance to muscular contraction using unconstrained weighted plates; the resistance is provided by the force of gravity acting on the free weights. Free weights are not attached to any other devices and do not restrict the user&apos;s movements; they usually include barbells and dumbbells.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C2721764</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000182 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000182">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000181"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000181"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Free weight exercisers designed to provide resistance to muscular contraction using two weight plates connected by a short bar (i.e., dumbbells and weight); the resistance is provided by the force of gravity acting on the dumbbells.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C2720528</oboInOwl:hasDbXref>
