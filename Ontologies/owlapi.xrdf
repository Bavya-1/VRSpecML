    <!-- http://purl.obolibrary.org/obo/TRAK_0000304 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000304">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000303"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000303"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start jogging forward, plant the foot of the injured leg and push off at a 45 or 90 degree angle. Repeat the sequence in the other direction.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0454380</oboInOwl:hasDbXref>
