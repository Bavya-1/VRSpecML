        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Lie down on the back with knees bent and feet on the floor. Action: Lift pelvis off the ground by pushing through feet, hold this position and then return to the start position. Variations: adding neutral spine position; extending the unaffected knee; placing feet on a step or a gym ball.</obo:IAO_0000115>
        <obo:UMLS_TUI_T155 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000056"/>
        <obo:UMLS_TUI_T155 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000066"/>
