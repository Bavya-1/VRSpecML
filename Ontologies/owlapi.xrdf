    <!-- http://purl.obolibrary.org/obo/TRAK_0001168 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001168">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001278"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T188"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000158"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001278"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand on the step. Action: Slowly bend the affected knee until the other foot lightly touches the floor in front. Keep the affected leg on the step and slowly straighten up the affected knee. Variations: adding hand weights.</obo:IAO_0000115>
        <obo:UMLS_TUI_T188 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000158"/>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001168</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">step downs</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001168</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001169 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001169">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000142"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000142"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand upright on the step. Action: Jump off the step and land with equal weight on both legs. Variations: catching and throwing a ball; altering trunk position.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">jumping off</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001169</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">jumping down steps</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001169</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001170 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001170">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000141"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000141"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand on the affected leg on the step. Action: Hop off the step and land keeping balance on the affected leg. Variations: catching and throwing a ball.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hopping off</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001170</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hopping down steps</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001170</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001171 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001171">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000141"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000141"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand on the affected leg. Action: Bend the knee and hop to rotate around 45 degrees and land keeping balance on the affected leg. Hop in the other direction. Variations: catching and throwing a ball; on an uneven or unstable surface; adding upper body movements.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001171</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rotational hopping</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001171</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001172 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001172">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000304"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000304"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand upright. Action: Jog in a straight line, decelerate on the affected leg then push off at a 45 or 90 degree angle to continue jogging. Repeat the whole sequence in the other direction.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001172</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direction changing jogging</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001172</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001173 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001173">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000152"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T155"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000066"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T188"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000157"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T188"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000158"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000152"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand upright with the affected leg slightly behind. Action: Bend the affected knee by curling the heel upwards. Variations: adding weights around the ankle.</obo:IAO_0000115>
        <obo:UMLS_TUI_T155 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000066"/>
        <obo:UMLS_TUI_T188 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000157"/>
        <obo:UMLS_TUI_T188 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000158"/>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001173</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hamstring curl (standing)</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001173</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001174 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001174">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000160"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T155"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000066"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000160"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand and place your affected leg on a step. Action: Lean forward and feel a comfortable stretch down the back of the thigh/knee, hold and then relax.</obo:IAO_0000115>
        <obo:UMLS_TUI_T155 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000066"/>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001174</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hamstring stretch (standing)</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001174</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001175 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001175">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000143"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000143"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand upright. Action: Push off using the affected leg, bring the unaffected leg up towards your chest, land on both legs and repeat on the other leg. Variations: upper body movements; landing on one leg.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001175</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">high skipping</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001175</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001176 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001176">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001278"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001278"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand on the affected leg, sideways to the step. Action: Bend the affected knee so that the other foot lightly touches the ground. Variations: adding hand weights, upper body movements.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001176</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lateral step downs</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001176</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001177 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001177">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000135"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T188"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000157"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T188"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000158"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000135"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand with the affected leg forward. Action: Slowly bend the affected knee and move the body weight forward onto the affected leg until the knee is flexed 90 degrees and directly above the toes while rotating the upper body to one side, then slowly straighten knees back to the start position. Repeat on the other side.</obo:IAO_0000115>
        <obo:UMLS_TUI_T188 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000157"/>
        <obo:UMLS_TUI_T188 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000158"/>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001177</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rotational lunges</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001177</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001178 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001178">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001278"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001278"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand upright. Action: Step out to one side and transfer the body weight onto that side with knees slightly bent. Return to the start position. Repeat on the other side. Variations: increasing the speed; on an uneven or unstable surface; throwing a ball at a target; adding upper body movements; adding hand weights.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001178</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">side steps</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001178</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001179 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001179">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000134"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T188"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000157"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T188"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000158"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000134"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand on the affected leg with the unaffected leg extended behind, resting on a step. Action: Slowly bend the affected knee as low as is comfortable and then straighten knees back to the start position.</obo:IAO_0000115>
        <obo:UMLS_TUI_T188 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000157"/>
        <obo:UMLS_TUI_T188 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000158"/>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001179</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sprint squats on step</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001179</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001180 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001180">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000301"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000301"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand upright. Action: Step with the affected leg forward so the heel touches the ground, transfer the body weight onto this leg. Return to the start position.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001180</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">forward stepping</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001180</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001181 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001181">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000301"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000301"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand upright. Action: Step with the affected leg backwards so the toes touch the ground, transfer the body weight onto this leg. Return to the start position.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001181</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">backward stepping</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001181</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001182 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001182">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000124"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T155"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001087"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000124"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A set of exercises to develop the strength and coordination of core muscles (including abdominal, lower back and pelvic muscles) in order to increase core stability.</obo:IAO_0000115>
        <obo:UMLS_TUI_T155 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001087"/>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001182</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">core stability exercise</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001182</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001183 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001183">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000138"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000138"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand upright. Action: Lift the unaffected leg off the ground and maintain the balance on the affected leg without dropping the pelvis, using the arms or using the unaffected leg for support. Variations: tighten pelvic floor and lower abdominals; adding hand weights; on an uneven or unstable surface; throwing a ball at a target; adding upper body movements.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">single leg stance</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001183</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">single leg balance</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001183</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001184 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001184">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000138"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000138"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Balance on the affected leg. Action: Reach with the unaffected leg forward as far as you can, maintaining balance on the affected leg and then return to the start position. Repeat in the other three directions, i.e. backward and out to both sides, maintaining balance on the affected leg throughout. Variations: throwing and catching a ball.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001184</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">star excursion balance</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001184</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001185 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001185">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001003"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001003"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A patella baja is an abnormally low lying patella.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">patella infera</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001185</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">patella baja</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001185</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001186 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001186">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001003"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001003"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An excessive shift of patella toward the outside (lateral) aspect of the knee joint.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C2139219</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001186</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lateral shift of patella</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001186</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001187 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001187">
