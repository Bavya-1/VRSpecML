        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Space floor markers on the ground and stand at one end. Action: jog forwards weaving in and out of the floor markers. Variations: changing speed; changing marker distance; dribbling or bouncing a ball.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
