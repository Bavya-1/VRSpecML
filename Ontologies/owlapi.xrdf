        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dislocations are joint injuries that force the ends of your bones out of position. When a dislocation occurs, you cannot move the joint. You can dislocate your ankles, knees, shoulders, hips and elbows. Dislocated joints often are swollen, very painful and visibly out of place.</obo:IAO_0000115>
        <obo:UMLS_TUI_T152 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000017"/>
