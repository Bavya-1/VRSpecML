    <!-- http://purl.obolibrary.org/obo/TRAK_0000434 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000434">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000520"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000559"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001292"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Patient supine on the examination table. Flex the knee to 30 degrees over the side of the table, place one hand about the lateral aspect of the knee, and grasp the ankle with the other hand. Apply abduction (valgus) stress to the knee. The test must also be performed in full extension.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000520"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000559"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001292"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0231733</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">abduction test</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000434</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">valgus stress test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000434</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000434"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Patient supine on the examination table. Flex the knee to 30 degrees over the side of the table, place one hand about the lateral aspect of the knee, and grasp the ankle with the other hand. Apply abduction (valgus) stress to the knee. The test must also be performed in full extension.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:12690600</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000435 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000435">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000542"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for a meniscal injury. The patient starts in a standing position with the knees fully extended and the feet 30cm apart. If testing the medial meniscus, the feet will be fully externally rotated. If testing the lateral meniscus, the feet will be internally rotated. The patient then squats and then slowly stands up to return to the starting position. The test is positive when pain and/or a click is felt by the patient at the related site of the joint line.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000542"/>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000435</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ege&apos;s test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000435</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000435"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for a meniscal injury. The patient starts in a standing position with the knees fully extended and the feet 30cm apart. If testing the medial meniscus, the feet will be fully externally rotated. If testing the lateral meniscus, the feet will be internally rotated. The patient then squats and then slowly stands up to return to the starting position. The test is positive when pain and/or a click is felt by the patient at the related site of the joint line.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physiopedia:Ege&apos;s_Test</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000436 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000436">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000530"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000556"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Patient supine with toes pointing upwards. The patient is asked to perform an isometric contraction of quadriceps femoris muscle against the table. The tracking of the patella is graded. The patella should be pulled in a straight superior direction or superior and lateral in equal proportions. If the patella tracks more laterally than superiorly, then the test is positive.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000530"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000556"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C2110568</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000436</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lateral pull test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000436</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000436"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Patient supine with toes pointing upwards. The patient is asked to perform an isometric contraction of quadriceps femoris muscle against the table. The tracking of the patella is graded. The patella should be pulled in a straight superior direction or superior and lateral in equal proportions. If the patella tracks more laterally than superiorly, then the test is positive.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:11451307</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000437 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000437">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000530"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000556"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for assessing patellar laxity. The patient lies supine. The examiner lifts the lateral edge of patella from the lateral femoral condyle avoiding lateral subluxation. Normally the patella lies parallel to the horizontal or the outer edge may be slightly tilted up (less than 10 degrees). A neutral or negative angle indicates excessively tight lateral restraint. A high positive angle indicates deficiencies of the lateral constraints.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000530"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000556"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C2110574</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000437</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">passive patellar tilt test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000437</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000438 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000438">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000542"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for a meniscal injury. The test is performed with the patient supine and the leg cradled between the examiner&apos;s trunk and arm while the index finger and thumb of the opposite hand are placed over the anterior joint line. A valgus stress is applied to the knee as it is passively flexed to 45 degrees; then a varus stress is applied to the knee as it is passively extended, producing a circular motion to the knee. The motion is repeated, increasing the varus and valgus stresses with each rotation of the knee. Positive result is &apos;grinding&apos; sensation felt with examiner&apos;s hand.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000542"/>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">medial-lateral grind test</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000438</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anderson grind test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000438</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000438"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for a meniscal injury. The test is performed with the patient supine and the leg cradled between the examiner&apos;s trunk and arm while the index finger and thumb of the opposite hand are placed over the anterior joint line. A valgus stress is applied to the knee as it is passively flexed to 45 degrees; then a varus stress is applied to the knee as it is passively extended, producing a circular motion to the knee. The motion is repeated, increasing the varus and valgus stresses with each rotation of the knee. Positive result is &apos;grinding&apos; sensation felt with examiner&apos;s hand.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:3755297</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000439 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000439">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000542"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for a meniscal injury. The patient is seated. The examiner immobilizes the foot of the affected leg. The examiner palpates the medial joint line and moves the patient&apos;s knee in a circle with tibial rotation. At the same time, the examiner applies a varus or valgus stress. Pain increased with the circular motion indicates a positive test.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000542"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C2110391</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000439</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Passler rotational grind test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000439</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000440 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000440">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000542"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for a meniscal injury. The patient is sitting with legs crossed. The examiner exerts downward pressure along the medial aspect of the affected knee. Medial knee pain indicates a positive test, usually a lesion of the posterior horn.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000542"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C2110394</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000440</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Payr test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000440</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000441 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000441">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000511"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000557"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001294"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The subject is supine, hip flexed to 45 degrees and knee flexed to 90 degrees. Examiner sits on the subject&apos;s foot, with hands behind the proximal tibia and thumbs on the tibial plateau. Anterior force applied to the proximal tibia. Hamstring tendons palpated with index fingers to ensure relaxation. Increased tibial displacement compared with the opposite side is indicative of an ACL tear.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000511"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000557"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001294"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0231737</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000441</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">anterior drawer test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000441</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000441"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The subject is supine, hip flexed to 45 degrees and knee flexed to 90 degrees. Examiner sits on the subject&apos;s foot, with hands behind the proximal tibia and thumbs on the tibial plateau. Anterior force applied to the proximal tibia. Hamstring tendons palpated with index fingers to ensure relaxation. Increased tibial displacement compared with the opposite side is indicative of an ACL tear.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:12690600</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000442 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000442">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000516"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000558"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001295"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Subject is supine with the test hip flexed to 45 degrees, knee flexed to 90 degrees, and foot in a neutral position. The examiner is sitting on the subject&apos;s foot with both hands behind the subject&apos;s proximal tibia and thumbs on the tibial plateau. Apply a posterior force to the proximal tibia. Increased posterior tibial displacement as compared with the uninvolved side is indicative of a partial or complete tear of the PCL.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000516"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000558"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001295"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0231738</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000442</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">posterior drawer test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000442</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000442"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Subject is supine with the test hip flexed to 45 degrees, knee flexed to 90 degrees, and foot in a neutral position. The examiner is sitting on the subject&apos;s foot with both hands behind the subject&apos;s proximal tibia and thumbs on the tibial plateau. Apply a posterior force to the proximal tibia. Increased posterior tibial displacement as compared with the uninvolved side is indicative of a partial or complete tear of the PCL.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:12690600</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000443 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000443">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000511"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000557"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001294"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Patient lies supine. Knee held between full extension and 15 degrees of flexion. Femur is stabilized with one hand while firm pressure is applied to the posterior aspect of the proximal tibia in an attempt to translate it anteriorly. Test is positive (indicating ACL rupture) when there is anterior translation of the tibia with &apos;soft&apos; endpoint.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000511"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000557"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001294"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0231752</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000443</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lachman test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000443</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000443"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Patient lies supine. Knee held between full extension and 15 degrees of flexion. Femur is stabilized with one hand while firm pressure is applied to the posterior aspect of the proximal tibia in an attempt to translate it anteriorly. Test is positive (indicating ACL rupture) when there is anterior translation of the tibia with &apos;soft&apos; endpoint.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:12690600</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000444 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000444">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000516"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000558"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001295"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for posterior instability. The patient lies supine and the knee flexed to 20-30 degrees. The examiner draws the tibia posteriorly relative to the femur. The excessive magnitude of tibial motion compared to the uninjured knee together with a soft end feel indicates a positive test.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000516"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000558"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001295"/>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000444</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">reverse Lachman test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000444</skos:notation>
    </owl:Class>
    


