        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">assisted exercise for range of motion</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000312</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000313 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000313">
