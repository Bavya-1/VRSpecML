        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000181"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The kettlebell is a cast-iron weight (resembling a cannonball with a handle) used to perform ballistic exercises that combine cardiovascular, strength and flexibility training.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C2721233</oboInOwl:hasDbXref>
