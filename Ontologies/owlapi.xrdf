        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">organ system</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001128</skos:notation>
