        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An exercise where a person performs a desired movement to the best of their ability with external assistance to complete a full range of motion and reduce resistance to the limb.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C2065118</oboInOwl:hasDbXref>
