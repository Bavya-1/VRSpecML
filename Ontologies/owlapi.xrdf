            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001071"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The long, heavy triangular muscle of the medial aspect of the thigh. The adductor magnus acts to adduct the thigh. The proximal portion acts to rotate the thigh medially and flex it on the hip; the distal portion acts to extend the thigh and rotate it laterally.</obo:IAO_0000115>
        <obo:UMLS_TUI_T188 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000004"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:22443</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0224438</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001066</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">adductor magnus</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001066</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001066"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The long, heavy triangular muscle of the medial aspect of the thigh. The adductor magnus acts to adduct the thigh. The proximal portion acts to rotate the thigh medially and flex it on the hip; the distal portion acts to extend the thigh and rotate it laterally.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MedicalDictionary:adductor+magnus</oboInOwl:hasDbXref>
    </owl:Axiom>
    


