    <!-- http://purl.obolibrary.org/obo/TRAK_0000626 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000626">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000546"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Thessaly test is a dynamic reproduction of joint loading in the knee. The test is performed at 5 degrees and 20 degrees of flexion. The examiner supports the patient by holding their outstretched hands while the patient stands flatfooted on the floor. The patient then rotates his or her knee and body, internally and externally, three times, keeping the knee in slight flexion (5 degrees). The same procedure is then carried out with the knee flexed at 20 degrees. Patients with suspected meniscal tears experience medial or lateral joint line discomfort and may have a sense of locking or catching.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000546"/>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000626</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thessaly test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000626</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000626"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Thessaly test is a dynamic reproduction of joint loading in the knee. The test is performed at 5 degrees and 20 degrees of flexion. The examiner supports the patient by holding their outstretched hands while the patient stands flatfooted on the floor. The patient then rotates his or her knee and body, internally and externally, three times, keeping the knee in slight flexion (5 degrees). The same procedure is then carried out with the knee flexed at 20 degrees. Patients with suspected meniscal tears experience medial or lateral joint line discomfort and may have a sense of locking or catching.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physiopedia:Thessaly_test</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000627 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000627">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001065"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T188"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T188"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000010"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001065"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The most superficial of the five medial femoral muscles. It is a thin, flattened muscle that is broad proximally and narrow distally. It functions to adduct the thigh and flex the leg and to assist in the medial rotation of the leg after it is flexed.</obo:IAO_0000115>
        <obo:UMLS_TUI_T188 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000006"/>
        <obo:UMLS_TUI_T188 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000010"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:43882</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0242693</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000627</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gracilis</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000627</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000627"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The most superficial of the five medial femoral muscles. It is a thin, flattened muscle that is broad proximally and narrow distally. It functions to adduct the thigh and flex the leg and to assist in the medial rotation of the leg after it is flexed.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MedicalDictionary:gracilis</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000629 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000629">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000830"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for joint effusion in the knee area. The patient lies in supine with the knee in full extension and relaxed. The examiner sweeps their hand upwards 2 or 3 times from beneath the medial tibiofemoral joint line towards the supra patellar bursa.  The examiner then strokes downwards on the lateral aspect of the knee, superior to the suprapatellar bursa towards the lateral joint line. The test is positive if a small bulge is detected on the medial aspect of the knee inferior to the patella.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000830"/>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fluctuation test</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wipe test</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000629</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sweep test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000629</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000629"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for joint effusion in the knee area. The patient lies in supine with the knee in full extension and relaxed. The examiner sweeps their hand upwards 2 or 3 times from beneath the medial tibiofemoral joint line towards the supra patellar bursa.  The examiner then strokes downwards on the lateral aspect of the knee, superior to the suprapatellar bursa towards the lateral joint line. The test is positive if a small bulge is detected on the medial aspect of the knee inferior to the patella.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physiopedia:Sweep_test</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000630 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000630">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001144"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T151"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000627"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001144"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nerve that arises from the second, third, and fourth lumbar nerves and enters the thigh through the obturator canal. It is responsible for the sensory innervation of the skin of the medial aspect of the thigh and also responsible for the motor innervation of the adductor muscles of the lower extremity.</obo:IAO_0000115>
        <obo:UMLS_TUI_T151 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000627"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:16487</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0028783</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000630</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">obturator nerve</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000630</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000630"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nerve that arises from the second, third, and fourth lumbar nerves and enters the thigh through the obturator canal. It is responsible for the sensory innervation of the skin of the medial aspect of the thigh and also responsible for the motor innervation of the adductor muscles of the lower extremity.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C0028783</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000631 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000631">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000830"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for joint effusion in the knee area. The patient lies supine with the leg extended. The examiner puts pressure on the proximal side of the knee to squeeze the fluid out of the suprapatellar pouch. While maintaining pressure on the suprapatellar pouch the other hand presses up on the medial and lateral recesses. Tap down the patella with the index finger to create an upward and downward movement and a palpable &apos;click&apos; as the patella hits the underlying femur. The test is positive if the patella can be felt to move down through the fluid. If the femur and the patella are already in contact, the test is negative. Both knees are always tested for comparison in order to avoid false positives.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000830"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0231756</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000631</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">patellar tap</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000631</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000631"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for joint effusion in the knee area. The patient lies supine with the leg extended. The examiner puts pressure on the proximal side of the knee to squeeze the fluid out of the suprapatellar pouch. While maintaining pressure on the suprapatellar pouch the other hand presses up on the medial and lateral recesses. Tap down the patella with the index finger to create an upward and downward movement and a palpable &apos;click&apos; as the patella hits the underlying femur. The test is positive if the patella can be felt to move down through the fluid. If the femur and the patella are already in contact, the test is negative. Both knees are always tested for comparison in order to avoid false positives.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physiopedia:Effusion_tests</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000632 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000632">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000565"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for a fat pad impingement. The patient is supine with their knees bent. The examiner presses both thumbs deeply along the sides of the patellar tendon just below the patella. The patient is then instructed to straighten the leg. Pain and/or apprehension of the patient indicate a positive test.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000565"/>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000632</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hoffa test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000632</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000633 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000633">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000231"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for patellofemoral pain syndrome. The subject is supine and relaxed with both knees supported by a knee pad. The examiner presses the patella distally and then asks the subject to contract the quadriceps muscle. The pain indicates positive test.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000231"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0430759</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">patellar compression test</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">patellofemoral grinding test</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000633</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clarke test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000633</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000633"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for patellofemoral pain syndrome. The subject is supine and relaxed with both knees supported by a knee pad. The examiner presses the patella distally and then asks the subject to contract the quadriceps muscle. The pain indicates positive test.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:15950517</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000634 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000634">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000516"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000558"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001295"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Patient lies supine with the hip flexed to 45 degrees and the knee flexed to 90 degrees. In this position, the tibia rocks back, or sags back, on the femur if the PCL is torn. Normally, the medial tibial plateau extends 1cm anteriorly beyond the femoral condyle when the knee is flexed 90 degrees. If this step-off is lost, the step-off test is considered positive.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000516"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000558"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001295"/>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Godfrey test</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">posterior sag sign</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000634</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">posterior sag test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000634</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000634"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Patient lies supine with the hip flexed to 45 degrees and the knee flexed to 90 degrees. In this position, the tibia rocks back, or sags back, on the femur if the PCL is torn. Normally, the medial tibial plateau extends 1cm anteriorly beyond the femoral condyle when the knee is flexed 90 degrees. If this step-off is lost, the step-off test is considered positive.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:12690600</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000635 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000635">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000516"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000558"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001295"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Subject is supine with knee flexed to 90 degrees in the drawer-test position. The foot is stabilized by the examiner, and the subject is asked to slide the foot gently down the table. Contraction of the quadriceps muscle in the PCL-deficient knee results in an anterior shift of the tibia of not less than 2mm. The test is qualitative.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000516"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000558"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001295"/>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
