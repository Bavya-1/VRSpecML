        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000141"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand on the affected leg in front of the step. Action: Bend the affected knee, hop up onto the step and land keeping balance on the affected leg. Variations: catching and throwing a ball.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hopping on</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
