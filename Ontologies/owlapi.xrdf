    <!-- http://purl.obolibrary.org/obo/TRAK_0000105 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000105">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000102"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/TRAK#performed_on"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000046"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/TRAK#performed_on"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001027"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/TRAK#performed_on"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001072"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000102"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A technique developed for pain and inflammation relief in musculoskeletal conditions. It attempts to reduce abnormal fibrous adhesions, mobilise scar tissue and enhance normal healing. Its mechanical action causes hyperaemia, which results in increased blood flow to the area.</obo:IAO_0000115>
        <TRAK:performed_on rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000046"/>
        <TRAK:performed_on rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001027"/>
        <TRAK:performed_on rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001072"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0556841</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DTFM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000105</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">deep transverse friction massage</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000105</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000105"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A technique developed for pain and inflammation relief in musculoskeletal conditions. It attempts to reduce abnormal fibrous adhesions, mobilise scar tissue and enhance normal healing. Its mechanical action causes hyperaemia, which results in increased blood flow to the area.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:12519601</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000106 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000106">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000102"/>
        <rdfs:subClassOf>
