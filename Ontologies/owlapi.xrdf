        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">meniscus</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000045</skos:notation>
    </owl:Class>
    <owl:Axiom>
