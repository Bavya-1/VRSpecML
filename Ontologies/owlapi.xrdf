    <!-- http://purl.obolibrary.org/obo/TRAK_0000053 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000053">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000960"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/TRAK#systemic_part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001420"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000960"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001420"/>
        <obo1:part_of rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001420"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A band of fibrous tissue that attaches the apex of the PATELLA to the lower part of the tubercle of the TIBIA. The ligament is actually the caudal continuation of the common tendon of the QUADRICEPS FEMORIS. The patella is embedded in that tendon. As such, the patellar ligament can be thought of as connecting the quadriceps femoris tendon to the tibia, and therefore it is sometimes called the patellar tendon.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:44581</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0206332</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">central band of tendon of quadriceps femoris</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ligamentum patella</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">patella tendon</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">patellar ligament</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000053</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">patellar tendon</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000053</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000053"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A band of fibrous tissue that attaches the apex of the PATELLA to the lower part of the tubercle of the TIBIA. The ligament is actually the caudal continuation of the common tendon of the QUADRICEPS FEMORIS. The patella is embedded in that tendon. As such, the patellar ligament can be thought of as connecting the quadriceps femoris tendon to the tibia, and therefore it is sometimes called the patellar tendon.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C0206332</oboInOwl:hasDbXref>
    </owl:Axiom>
    


