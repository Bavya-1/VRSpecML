            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000152"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Lie down on back with affected knee bent and foot on the floor, the other leg extended out and off the ground. Action: Lift pelvis off the ground by pushing through the foot of the affected leg, then slowly return to the start position. Variations: adding neutral spine position; placing foot on a step or a gym ball.</obo:IAO_0000115>
        <obo:UMLS_TUI_T155 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000056"/>
        <obo:UMLS_TUI_T155 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000066"/>
