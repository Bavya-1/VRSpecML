    <!-- http://purl.obolibrary.org/obo/TRAK_0000410 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000410">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000138"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000138"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand on uneven or unstable surface (e.g. grass, soft mat, trampoline, balance cushion, wobble board, soft carpet, sand, etc.) and balance on the affected leg. Action: Maintain balance on the affected leg without using your arms or the unaffected leg for support.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000410</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">single leg balance on uneven or unstable surface</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000410</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000411 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000411">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000138"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000138"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Balance on the affected leg. Action: Maintain balance on the affected leg without using your arms or the unaffected leg for support and throw and catch a ball. Variations: standing on an uneven or unstable surface.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000411</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">single leg balance with ball catching</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000411</skos:notation>
    </owl:Class>
    


