        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000134"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand on the affected leg with the unaffected leg extended behind, resting on a supporting surface. Action: Slowly bend the affected knee as low as is comfortable and then straighten knees back to the start position. Variations: adding hand weights; varying the trunk angle; adding calf raises when rising from the squat; on an uneven or unstable surface; throwing a ball at a target; adding upper body movements; using a step to support the unaffected leg.</obo:IAO_0000115>
        <obo:UMLS_TUI_T188 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000157"/>
        <obo:UMLS_TUI_T188 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000158"/>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001267</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sprint squats</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001267</skos:notation>
    </owl:Class>
    


