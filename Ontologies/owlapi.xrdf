        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A stretching technique used to increase range of joint motion. This is achieved by maximally contracting and then relaxing a tightened muscle.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0454482</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">contract relax technique</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000100</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">hold relax technique</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000100</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000101 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000101">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000099"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000099"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Muscle energy technique is a type of osteopathic manipulative treatment used in osteopathic medicine and physical therapy. Muscle energy techniques are used to treat somatic dysfunction, especially decreased range of motion, muscular hypertonicity and pain.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C1562466</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000101</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">muscle energy technique</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000101</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000101"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Muscle energy technique is a type of osteopathic manipulative treatment used in osteopathic medicine and physical therapy. Muscle energy techniques are used to treat somatic dysfunction, especially decreased range of motion, muscular hypertonicity and pain.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MedicalDictionary:muscle+energy+technique</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000102 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000102">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000098"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000098"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A direct technique that usually involves lateral stretching, linear stretching, deep pressure, traction and/or separation of muscle origin and insertion while monitoring tissue response and motion changes by palpation.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C1704543</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000102</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soft tissue technique</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000102</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000102"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A direct technique that usually involves lateral stretching, linear stretching, deep pressure, traction and/or separation of muscle origin and insertion while monitoring tissue response and motion changes by palpation.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C1704543</oboInOwl:hasDbXref>
    </owl:Axiom>
    


