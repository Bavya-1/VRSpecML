        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Joint manipulation is the attempt to restore the full joint mobility by a single forceful movement.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MedicalDictionary:Joint+manipulation</oboInOwl:hasDbXref>
    </owl:Axiom>
    


