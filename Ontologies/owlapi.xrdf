    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000097"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000097"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Therapy dealing with lifestyle management and includes: behavioral and dietary modifications, exercise, stress management, and addiction control. This therapy must be used as major adjunct to &apos;standard care&apos; or be applied as alternative treatment to conventional medicine practices.</obo:IAO_0000115>
