    <!-- http://purl.obolibrary.org/obo/TRAK_0000318 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000318">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000126"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000126"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Power walking or speed walking is the act of walking with a speed at the upper end of the natural range for walking gait, typically 7 to 9 km/h (4.5 to 5.5 mph). To qualify as power walking as opposed to jogging or running, at least one foot must be in contact with the ground at all times.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">speed walking</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
