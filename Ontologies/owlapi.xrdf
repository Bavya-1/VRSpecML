        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Serous sac, which has as parts a synovial membrane and a synovial cavity. Examples: synovial bursa, synovial tendon sheath of index finger, synovial capsule of knee joint.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:66760</oboInOwl:hasDbXref>
    </owl:Axiom>
    


