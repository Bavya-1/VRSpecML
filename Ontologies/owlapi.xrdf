    <!-- http://purl.obolibrary.org/obo/TRAK_0001189 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001189">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000609"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000609"/>
