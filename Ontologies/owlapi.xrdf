                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001088"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000039"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001088"/>
        <obo1:part_of rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001088"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tissue responsible for the body movements and the shape and size changes of interna organs. Muscle tissue is composed of specialized contractile cells. There are two types of muscle tissue recognized:striated and smooth muscle. The striated muscle tissue is further subdivided into skeletal, visceral striated, and cardiac muscle.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:9641</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0026845</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000054</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">muscle tissue</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000054</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000054"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tissue responsible for the body movements and the shape and size changes of interna organs. Muscle tissue is composed of specialized contractile cells. There are two types of muscle tissue recognized:striated and smooth muscle. The striated muscle tissue is further subdivided into skeletal, visceral striated, and cardiac muscle.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C0026845</oboInOwl:hasDbXref>
    </owl:Axiom>
    


