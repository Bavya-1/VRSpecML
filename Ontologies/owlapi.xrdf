    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000228 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000228">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001550"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T152"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000046"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001550"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clinical syndrome describing overuse tendon injuries characterized by a combination of PAIN, diffuse or localized swelling, and impaired performance. Distinguishing tendinosis from tendinitis is clinically difficult and can be made only after histopathological examination.</obo:IAO_0000115>
        <obo:UMLS_TUI_T152 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000046"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C1568272</oboInOwl:hasDbXref>
        <oboInOwl:hasNarrowSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">jumper&apos;s knee</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000228</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tendinopathy</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000228</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000228"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clinical syndrome describing overuse tendon injuries characterized by a combination of PAIN, diffuse or localized swelling, and impaired performance. Distinguishing tendinosis from tendinitis is clinically difficult and can be made only after histopathological examination.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C1568272</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000229 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000229">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001549"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T152"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000046"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001549"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inflammation of TENDONS. It is characterized by the degeneration of tendons accompanied by an inflammatory repair response, fibroblastic proliferation, and formation of granulation tissue. Tendinitis is not a clinical diagnosis and can be confirmed only by histopathological findings.</obo:IAO_0000115>
        <obo:UMLS_TUI_T152 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000046"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RADLEX:RID3649</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0039503</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tendonitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000229</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tendinitis</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000229</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000229"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inflammation of TENDONS. It is characterized by the degeneration of tendons accompanied by an inflammatory repair response, fibroblastic proliferation, and formation of granulation tissue. Tendinitis is not a clinical diagnosis and can be confirmed only by histopathological findings.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C0039503</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000230 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000230">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001547"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T152"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000046"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001547"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A disorder of TENDONS characterized by COLLAGEN degeneration, other changes to tenocytes and the EXTRACELLULAR MATRIX, and a lack of inflammatory cells. It is caused by aging, microtrauma, or vascular compromise. Tendinosis is not a clinical diagnosis and can be confirmed only by histopathological findings.</obo:IAO_0000115>
        <obo:UMLS_TUI_T152 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000046"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RADLEX:RID5123</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C1568363</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000230</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tendinosis</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000230</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000230"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A disorder of TENDONS characterized by COLLAGEN degeneration, other changes to tenocytes and the EXTRACELLULAR MATRIX, and a lack of inflammatory cells. It is caused by aging, microtrauma, or vascular compromise. Tendinosis is not a clinical diagnosis and can be confirmed only by histopathological findings.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C1568363</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000231 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000231">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000205"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T152"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000022"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000205"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A syndrome characterized by retropatellar or peripatellar PAIN resulting from physical and biochemical changes in the patellofemoral joint. The pain is most prominent when ascending or descending stairs, squatting, or sitting with flexed knees.</obo:IAO_0000115>
        <obo:UMLS_TUI_T152 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000022"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0877149</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PFPS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">runner knee</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">runner&apos;s knee</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000231</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">patellofemoral pain syndrome</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000231</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000231"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A syndrome characterized by retropatellar or peripatellar PAIN resulting from physical and biochemical changes in the patellofemoral joint. The pain is most prominent when ascending or descending stairs, squatting, or sitting with flexed knees.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C0877149</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000232 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000232">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000205"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000205"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Joint impingement is a painful syndrome caused by the friction of joint tissues, which is both the cause and the effect of altered joint biomechanics. From the anatomical and clinical viewpoints, these syndromes are classified as bone impingement, soft tissue impingement and entrapment neuropathy, depending on what joint portion impinges on the others.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000232</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">impingement</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000232</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000232"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Joint impingement is a painful syndrome caused by the friction of joint tissues, which is both the cause and the effect of altered joint biomechanics. From the anatomical and clinical viewpoints, these syndromes are classified as bone impingement, soft tissue impingement and entrapment neuropathy, depending on what joint portion impinges on the others.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:9652500</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000233 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000233">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000205"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T152"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000020"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000205"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A non specific term used to cover a group of disorders involving disruption of the normal functioning of the knee joint.</obo:IAO_0000115>
        <obo:UMLS_TUI_T152 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000020"/>
        <oboInOwl:hasBroadSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">internal derangement</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0158053</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">IDK</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">derangement of knee</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000233</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">internal derangement of knee</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000233</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000234 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000234">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000199"/>
