        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000305</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000306 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000306">
