    <!-- http://purl.obolibrary.org/obo/TRAK_0001130 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001130">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000341"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000341"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The long jump is a track and field event in which athletes combine speed, strength, and agility in an attempt to leap as far as possible from a take off point.</obo:IAO_0000115>
