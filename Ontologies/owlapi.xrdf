    <!-- http://purl.obolibrary.org/obo/TRAK_0000167 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000167">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000166"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000166"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Exerciser designed to facilitate the physical exertion of body muscles by the voluntary contraction and relaxation of large muscle groups (i.e., active exercisers), which are intended primarily for making users breathe more deeply and their hearts work harder; activities in aerobic exercises can be usually maintained continuously and are rhythmic in nature. Dedicated aerobic exercisers are available for walking and jogging (e.g., treadmills), cycling (e.g., stationary bicycles), and other activities such as rowing, elliptical motion, or bouncing.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C2721216</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000167</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aerobic exerciser</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000167</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000167"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Exerciser designed to facilitate the physical exertion of body muscles by the voluntary contraction and relaxation of large muscle groups (i.e., active exercisers), which are intended primarily for making users breathe more deeply and their hearts work harder; activities in aerobic exercises can be usually maintained continuously and are rhythmic in nature. Dedicated aerobic exercisers are available for walking and jogging (e.g., treadmills), cycling (e.g., stationary bicycles), and other activities such as rowing, elliptical motion, or bouncing.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C2721216</oboInOwl:hasDbXref>
    </owl:Axiom>
    


