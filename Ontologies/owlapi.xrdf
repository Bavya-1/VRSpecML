    <!-- http://purl.obolibrary.org/obo/TRAK_0000139 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000139">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000654"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000654"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The sense of body position and movement, mediated by the labyrinth (equilibrium) and peripheral receptors in the muscles and elsewhere (limb and joint position); kinesthesia includes the latter, but not equilibrium.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0178811</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kinesthesia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000139</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">proprioception</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000139</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000139"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The sense of body position and movement, mediated by the labyrinth (equilibrium) and peripheral receptors in the muscles and elsewhere (limb and joint position); kinesthesia includes the latter, but not equilibrium.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C0178811</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000140 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000140">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000125"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000125"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Exercises in which muscles are repeatedly and rapidly stretched, followed by shortening, concentric MUSCLE CONTRACTION (e.g. jumping and rebounding). They are designed to exert maximal force in minimal time by increasing STRETCH REFLEX.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C3178799</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000140</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">plyometric exercise</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000140</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000140"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Exercises in which muscles are repeatedly and rapidly stretched, followed by shortening, concentric MUSCLE CONTRACTION (e.g. jumping and rebounding). They are designed to exert maximal force in minimal time by increasing STRETCH REFLEX.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C3178799</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000141 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000141">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000140"/>
