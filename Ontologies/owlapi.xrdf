        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000160"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Lie on back with knees bent. Action: Lift the affected leg, flexing at the hip and allowing the knee to rotate outwards. Rest the outer border of the ankle against the unaffected knee so that there is a comfortable stretch on the outer thigh. Variations: flexing the unaffected hip to increase the stretch.</obo:IAO_0000115>
        <obo:UMLS_TUI_T155 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000056"/>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001243</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gluteus stretch</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001243</skos:notation>
    </owl:Class>
    


