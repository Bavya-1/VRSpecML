    <!-- http://purl.obolibrary.org/obo/TRAK_0001620 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001620">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001619"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001619"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sign on MRI of the knee to increase the sensitivity of diagnosing meniscal tears. The rule states a meniscal tear is present if abnormal findings are present on two or more images - these do not have to be contiguous, e.g. can occur on sagittal and coronal slices. A possible meniscal tear is present if abnormal findings are present on only one slice.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001620</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">two-slice-touch rule</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001620</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001620"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sign on MRI of the knee to increase the sensitivity of diagnosing meniscal tears. The rule states a meniscal tear is present if abnormal findings are present on two or more images - these do not have to be contiguous, e.g. can occur on sagittal and coronal slices. A possible meniscal tear is present if abnormal findings are present on only one slice.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Radiopedia:two-slice-touch-rule-1</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001621 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001621">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001619"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001619"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The double PCL sign appears on sagittal MRI images of the knee when a bucket-handle tear of a meniscus flips medially so that comes to lie anteroinferior to the PCL mimicking a second smaller PCL.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001621</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">double PCL sign</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001621</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001621"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The double PCL sign appears on sagittal MRI images of the knee when a bucket-handle tear of a meniscus flips medially so that comes to lie anteroinferior to the PCL mimicking a second smaller PCL.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Radiopedia:double-pcl-sign</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001622 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001622">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001619"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001619"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The absent bow tie sign represents the loss of the normal appearance of the menisci on parasagittal MRI images, and is suggestive of meniscal injury.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
