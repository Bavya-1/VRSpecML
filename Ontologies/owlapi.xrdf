    <!-- http://purl.obolibrary.org/obo/TRAK_0001032 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001032">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001134"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001134"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A layer of connective tissue that lines the cavities of joints, tendon sheaths, and bursae (fluid-filled sacs between tendons and bones). The synovial membrane makes synovial fluid, which has a lubricating function.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FMA:66762</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0039099</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">synovial layer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001032</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">synovial membrane</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001032</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001032"/>
