        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand with the affected leg on a step. Action: Slowly bend the affected knee and move the body weight forward onto the affected leg as much as is comfortable, then slowly straighten knees back to the start position.</obo:IAO_0000115>
        <obo:UMLS_TUI_T188 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000157"/>
