        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001026"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Squash is a high-speed racquet sport played by two players (or in doubles 4 players on court at a time) in a four-walled court with a small, hollow rubber ball.</owl:annotatedTarget>
