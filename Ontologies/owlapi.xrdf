    <!-- http://purl.obolibrary.org/obo/TRAK_0001160 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001160">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001144"/>
