        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000304</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">direction changing exercise</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000304</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000305 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000305">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000304"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000304"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Space two floor markers on the ground. Action: Run in figure of 8 patterns around the floor markers. Variations: changing speed, changing marker distance.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000305</oboInOwl:id>
