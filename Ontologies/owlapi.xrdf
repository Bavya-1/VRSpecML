        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lysholm knee scoring scale</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000678</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000678"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lysholm knee scoring scale is a scoring scale for knee ligament surgery follow-up emphasizing evaluation of symptoms of instability, which is defined as &apos;giving way&apos; during activity.</owl:annotatedTarget>
