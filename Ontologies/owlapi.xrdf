        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">knee flexion overpressure</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001241</skos:notation>
    </owl:Class>
    


