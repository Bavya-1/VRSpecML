        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000199"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000858"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Giving way is where the knee suddenly &apos;gives out&apos;, causing one to stumble or fall.</obo:IAO_0000115>
