        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">power walking</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000318</skos:notation>
    </owl:Class>
