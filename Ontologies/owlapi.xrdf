                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001292"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001293"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The patient is prone with the knee flexed at 90 degrees. The examiner grasps the foot with both hands and externally rotates it as far as possible while pulling the tibia upwards. When this limit is reached, the examiner rotates the foot internally. Increased pain during rotation indicates a positive test.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000520"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000527"/>
