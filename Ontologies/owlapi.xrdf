            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T188"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000157"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T188"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000158"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000134"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand upright with feet shoulder width apart. Action: Slowly bend knees until the thighs are parallel to the floor, then slowly straighten knees back to the start position.</obo:IAO_0000115>
        <obo:UMLS_TUI_T188 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000157"/>
        <obo:UMLS_TUI_T188 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000158"/>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000430</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">basic squats</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000430</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000431 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000431">
