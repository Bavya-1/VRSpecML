        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pharmacist</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001206</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001206"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A person trained in pharmacy that prepares and dispenses drugs prescribed by physicians and health practitioners. The responsibilities include instructing patients on the use, hazards, interactions, and side effects of any drug dispensed.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C0031323</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001207 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001207">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001204"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001204"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An orthotist is a healthcare professional who specialises in the use of devices (orthoses) to support weakened joints, correct deformities and reduce pain and strain when the affected joints are being used in everyday life.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0586952</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001207</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">orthotist</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001207</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001208 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001208">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001204"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001204"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Orthopedic surgeons are healthcare professionals who use both surgical and nonsurgical means to treat musculoskeletal trauma, sports injuries, degenerative diseases, infections, tumors, and congenital disorders.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0334891</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">orthopaedic surgeon</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">orthopedist</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001208</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">orthopedic surgeon</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001208</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001208"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Orthopedic surgeons are healthcare professionals who use both surgical and nonsurgical means to treat musculoskeletal trauma, sports injuries, degenerative diseases, infections, tumors, and congenital disorders.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wikipedia:Orthopedic_surgery</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001209 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001209">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001204"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001204"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A professional trained and qualified to provide nutritional services at individual, institutional and community levels in term of assessing nutritional needs and coordinating them with medical ones, developing and implementing nutrition programs, evaluation and reporting their results, as well as to educate people on healthy eating, and diseases prevention and treatment by means of dietary modifications.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0237083</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dietician</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dietitian</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001209</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nutritionist</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001209</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001209"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A professional trained and qualified to provide nutritional services at individual, institutional and community levels in term of assessing nutritional needs and coordinating them with medical ones, developing and implementing nutrition programs, evaluation and reporting their results, as well as to educate people on healthy eating, and diseases prevention and treatment by means of dietary modifications.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C0237083</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001210 -->

