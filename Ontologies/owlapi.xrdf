    <!-- http://purl.obolibrary.org/obo/TRAK_0001255 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001255">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001182"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001182"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Lie on back with knees bent and feet on the floor. Place hands on lower abdominals. Find the neutral spine position by tilting the pelvis backwards and forwards and settling into a position midway between the two. There will be a small gap beneath the lower back. Action: Tighten pelvic floor muscles and then the lower abdominal muscles. Spine and pelvis position should not change. Hold this position and then relax. Variations: sitting, standing.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001255</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">neutral spine control</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001255</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001257 -->

