        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001127"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The ligament that travels from the medial epicondyle of the FEMUR to the medial margin and medial surface of the TIBIA. The medial meniscus is attached to its deep surface.</obo:IAO_0000115>
