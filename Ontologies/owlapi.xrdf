        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lunges on step</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000407</skos:notation>
    </owl:Class>
    


