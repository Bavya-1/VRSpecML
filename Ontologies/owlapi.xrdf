    <!-- http://purl.obolibrary.org/obo/TRAK_0000100 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000100">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000099"/>
