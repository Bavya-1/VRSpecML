        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A type of osteochondritis in which articular cartilage and associated bone becomes partially or totally detached to form joint loose bodies. Affects mainly the knee, ankle, and elbow joints.</obo:IAO_0000115>
        <obo:UMLS_TUI_T152 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001006"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RADLEX:RID5369</oboInOwl:hasDbXref>
