        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000051"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The ligament that travels from the medial epicondyle of the FEMUR to the medial margin and medial surface of the TIBIA. The medial meniscus is attached to its deep surface.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C0206367</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000052 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000052">
