    <!-- http://purl.obolibrary.org/obo/TRAK_0001206 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001206">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001204"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001204"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A person trained in pharmacy that prepares and dispenses drugs prescribed by physicians and health practitioners. The responsibilities include instructing patients on the use, hazards, interactions, and side effects of any drug dispensed.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0031323</oboInOwl:hasDbXref>
