        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000684</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000684"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A rating system for patients undergoing knee arthroplasty that rates only the knee joint itself and a functional score that rates the patient&apos;s ability to walk and climb stairs.</owl:annotatedTarget>
