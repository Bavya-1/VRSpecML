        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">isometric contraction</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000154</skos:notation>
    </owl:Class>
