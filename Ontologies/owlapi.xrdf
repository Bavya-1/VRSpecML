    <!-- http://purl.obolibrary.org/obo/TRAK_0001211 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001211">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001204"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001204"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An individual trained and certified to apply knowledge of the concepts, principles, and practices of physical therapy for the treatment or prevention of physical disability or disease. Physical therapist plans and carries out treatment utilizing therapeutic exercise, massage, and physical agents such as air, water, electricity, sound, and radiant energy; performs tests and measurements involving manual or electrical means; and interpret results. Therapist also devises adaptations of equipment to meet the specific needs of patients.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C2362565</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PT</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">physiotherapist</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001211</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">physical therapist</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001211</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001211"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An individual trained and certified to apply knowledge of the concepts, principles, and practices of physical therapy for the treatment or prevention of physical disability or disease. Physical therapist plans and carries out treatment utilizing therapeutic exercise, massage, and physical agents such as air, water, electricity, sound, and radiant energy; performs tests and measurements involving manual or electrical means; and interpret results. Therapist also devises adaptations of equipment to meet the specific needs of patients.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C2362565</oboInOwl:hasDbXref>
    </owl:Axiom>
    


