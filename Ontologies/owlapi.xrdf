    <!-- http://purl.obolibrary.org/obo/TRAK_0000450 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000450">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000569"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for a synovial plica syndrome. The patient is supine. The examiner flexes the knee with medial rotation of the tibia and pressing the patella medially while palpating just medial to the patella. A snapping and/or popping felt and/or heard indicates a positive test.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000569"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C2110592</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000450</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hughston plica test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000450</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000451 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000451">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000511"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000557"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001299"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The patient lies supine on the examination table. The examiner supports the involved side ankle with one hand. The tibia is externally rotated. The patient&apos;s knee is then flexed to approximately 45 degrees. The examiner places his other hand on the lateral side of the knee. The thumb is hooked behind the fibular head and the fingers are placed over the patella. This hand then applies a valgus force to the knee while the thumb lifts upward on the fibular head, internally rotating the tibia. The knee is slowly extended while the valgus force is being applied. The leg and foot are allowed to roll into internal rotation. If the test is positive, the lateral tibial plateau will suddenly subluxate anteriorly as the knee reaches approximately 10-20 degrees of flexion.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000511"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000557"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001299"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0231754</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000451</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Losee test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000451</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000451"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The patient lies supine on the examination table. The examiner supports the involved side ankle with one hand. The tibia is externally rotated. The patient&apos;s knee is then flexed to approximately 45 degrees. The examiner places his other hand on the lateral side of the knee. The thumb is hooked behind the fibular head and the fingers are placed over the patella. This hand then applies a valgus force to the knee while the thumb lifts upward on the fibular head, internally rotating the tibia. The knee is slowly extended while the valgus force is being applied. The leg and foot are allowed to roll into internal rotation. If the test is positive, the lateral tibial plateau will suddenly subluxate anteriorly as the knee reaches approximately 10-20 degrees of flexion.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:18796889</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000452 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000452">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000511"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000557"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001299"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The patient is supine on the table with the knee held at 30 degrees of flexion. The lower limb is braced against the abdomen of the examiner. While giving a lateral thrust on the tibia using the elbow of the examiner at the foot of the patient and a concomitant internal rotation of the tibia by an endotorsion of the hand placed upon the tibia one carries out the same downwards movement on the femur and upwards pushing of the tibia to evaluate anterolateral instability. A sudden snap of varying degree can easily be felt and seen in case of anterior subluxation of the lateral tibial plateau.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000511"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000557"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001299"/>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000452</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Martens test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000452</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000452"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The patient is supine on the table with the knee held at 30 degrees of flexion. The lower limb is braced against the abdomen of the examiner. While giving a lateral thrust on the tibia using the elbow of the examiner at the foot of the patient and a concomitant internal rotation of the tibia by an endotorsion of the hand placed upon the tibia one carries out the same downwards movement on the femur and upwards pushing of the tibia to evaluate anterolateral instability. A sudden snap of varying degree can easily be felt and seen in case of anterior subluxation of the lateral tibial plateau.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:7294985</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000454 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000454">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000511"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000557"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001298"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001299"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for anteromedial rotary instability and anterolateral rotary instability of the knee. The patient is supine with the knee flexed 90 degrees and the foot fixed to the examining table by the examiner. 30 degrees of internal rotation is applied to the tibia by rotating the foot. The examiner pulls anteriorly on the tibia to assess for anterolateral rotary instability. Results are compared bilaterally. Increased amount of anterior tibial translation with tibial internal rotation or excessive movement on the lateral aspect of the knee indicates anterolateral instability. To examine anteromedial rotary instability the tibia is laterally rotated 15 degrees and the tibia is once again pulled forward. Results are compared bilaterally. When pathologically increased forward and outward displacement of the tibia on the femur is possible, excessive anterior rotation of the medial tibial plateau indicates laxity of the medial structures.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000511"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000557"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001298"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001299"/>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0231763</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000454</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slocum test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000454</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000454"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for anteromedial rotary instability and anterolateral rotary instability of the knee. The patient is supine with the knee flexed 90 degrees and the foot fixed to the examining table by the examiner. 30 degrees of internal rotation is applied to the tibia by rotating the foot. The examiner pulls anteriorly on the tibia to assess for anterolateral rotary instability. Results are compared bilaterally. Increased amount of anterior tibial translation with tibial internal rotation or excessive movement on the lateral aspect of the knee indicates anterolateral instability. To examine anteromedial rotary instability the tibia is laterally rotated 15 degrees and the tibia is once again pulled forward. Results are compared bilaterally. When pathologically increased forward and outward displacement of the tibia on the femur is possible, excessive anterior rotation of the medial tibial plateau indicates laxity of the medial structures.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physiopedia:Slocum&apos;s_Test</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000455 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000455">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000511"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000557"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T163"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001299"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000656"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A test for anterolateral rotary instability of knee. The patient lies supine. The examiner immobilises the foot by wedging it between the body and the elbow. The examiner places one hand flat under the patient&apos;s tibia, pushing it forwards with the knee in extension. The other hand is placed against the patient&apos;s thigh, pushing the other way. The lower limb is taken into slight abduction by the examiner&apos;s elbow, with the examiner&apos;s body acting as a fulcrum to produce the valgus force. The examiner maintains the anterior tibial translation and the valgus force while flexing the knee. At 20-30 degrees of flexion, a positive test is indicated if pivot shift occurs with a clunk as the lateral tibial plateau suddenly reduces.</obo:IAO_0000115>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000511"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000557"/>
        <obo:UMLS_TUI_T163 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001299"/>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000455</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DeJour test</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000455</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000456 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000456">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000147"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T155"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000195"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000147"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Sit upright in a chair with the foot of the affected leg on the skateboard. Action: Slowly extend the affected knee by sliding the skateboard forward, then slowly flex the knee as much as is comfortable by sliding the skateboard backwards. Repeat.</obo:IAO_0000115>
        <obo:UMLS_TUI_T155 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000195"/>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000456</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">skateboard slide</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000456</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000457 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000457">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001065"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T188"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T188"/>
