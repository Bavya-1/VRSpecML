    <!-- http://purl.obolibrary.org/obo/TRAK_0000121 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000121">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000120"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000120"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A procedure in which small electric impulses are used to stimulate muscles that are weak or paralyzed. It helps to increase muscle strength, blood circulation, and range of motion and to lessen muscle spasms.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C2985393</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000121</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">neuromuscular electrical stimulation</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000121</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000121"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A procedure in which small electric impulses are used to stimulate muscles that are weak or paralyzed. It helps to increase muscle strength, blood circulation, and range of motion and to lessen muscle spasms.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C2985393</oboInOwl:hasDbXref>
    </owl:Axiom>
    


