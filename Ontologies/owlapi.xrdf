    <!-- http://purl.obolibrary.org/obo/TRAK_0000683 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000683">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001231"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001231"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A questionnaire that assesses how knee pain has affected one&apos;s ability to manage in everyday life. The original form of the Cincinnati Knee Rating System has multiple parts: symptoms, sports activity, and activities of daily living scales, along with clinical parameters. The modified version requires patient input only and provides the user with an overall score as well as symptom and functional subscores.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">URL:http://www.orthopaedicscore.com/scorepages/cincinnati.html</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000683</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">modified Cincinnati rating score</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000683</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000683"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A questionnaire that assesses how knee pain has affected one&apos;s ability to manage in everyday life. The original form of the Cincinnati Knee Rating System has multiple parts: symptoms, sports activity, and activities of daily living scales, along with clinical parameters. The modified version requires patient input only and provides the user with an overall score as well as symptom and functional subscores.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PMID:19633231</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000684 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000684">
