        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000112"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application of an ice pack to an injured area. A thin fabric should be placed on the skin to buffer the skin from the ice.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000114</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ice pack application</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000114</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000115 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000115">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000110"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000110"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The application of heat to appropriate painful areas to improve blood flow and function and to reduce pain. It can be applied though many methods, using convection, conduction, or radiation. Conduction uses hydrocollator, paraffin, or other similar methods. Convection uses immersion hydrotherapy, immersion, forced fluidotherapy, and radiant heat. Radiation uses laser.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0150611</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">therapeutic heat application</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000115</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">thermotherapy</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000115</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000115"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The application of heat to appropriate painful areas to improve blood flow and function and to reduce pain. It can be applied though many methods, using convection, conduction, or radiation. Conduction uses hydrocollator, paraffin, or other similar methods. Convection uses immersion hydrotherapy, immersion, forced fluidotherapy, and radiant heat. Radiation uses laser.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C0150611</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000116 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000116">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000115"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000115"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Applying heat to a client&apos;s body part or region for therapeutic effect(s) (for example, to increase circulation).</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0695361</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000116</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">thermotherapy with hot packs</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000116</skos:notation>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000116"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Applying heat to a client&apos;s body part or region for therapeutic effect(s) (for example, to increase circulation).</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS:C0695361</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000117 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000117">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000115"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000115"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The therapeutic elevation of temperature in the tissues by means of an oscillating electric current of extremely high frequency.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0492047</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000117</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">shortwave diathermy</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000117</skos:notation>
    </owl:Class>
    <owl:Axiom>
