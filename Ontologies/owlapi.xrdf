        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">weight shifting exercise</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0000302</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0000303 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000303">
