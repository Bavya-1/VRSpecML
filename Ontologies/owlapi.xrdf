        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001537"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inflammation or irritation of a bursa, the fibrous sac that acts as a cushion between moving structures of bones, muscles, tendons or skin.</obo:IAO_0000115>
        <obo:UMLS_TUI_T152 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001014"/>
