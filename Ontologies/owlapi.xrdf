        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000147"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Sit down with legs extended, the upper body slightly reclined and the ankle of the affected leg resting on a ball. Action: Push the affected knee towards the floor, tensing the front thigh muscles, hold and relax.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001239</oboInOwl:id>
