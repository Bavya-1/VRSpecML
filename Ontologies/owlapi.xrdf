        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001239</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001240 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001240">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000147"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000147"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Sit upright with legs straight out in front. Action: Bend the affected knee as much as possible, hold and then slowly return to the start position. Variation: on a low friction surface that allows the foot to slide easily.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">trak</oboInOwl:hasOBONamespace>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001240</oboInOwl:id>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">knee flexion</rdfs:label>
        <skos:notation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">TRAK:0001240</skos:notation>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/TRAK_0001241 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0001241">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000147"/>
