                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000157"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/UMLS_TUI_T188"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000158"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000134"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Start position: Stand upright with the back supported against a wall and feet shoulder width apart. Action: Slowly bend knees and slide down the wall until the thighs are parallel to the floor, then slowly straighten knees back to the start position.</obo:IAO_0000115>
        <obo:UMLS_TUI_T188 rdf:resource="http://purl.obolibrary.org/obo/TRAK_0000157"/>
