    <!-- http://purl.obolibrary.org/obo/TRAK_0000676 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRAK_0000676">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001231"/>
        <metadata:treeView rdf:resource="http://purl.obolibrary.org/obo/TRAK_0001231"/>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A 7-item measure of physical function derived from the function, daily living and function, sports and recreational activity subscales of the KOOS. It measures people&apos;s opinions about the difficulties they experience with activity due to problems with their knee.</obo:IAO_0000115>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">URL:http://www.koos.nu/KOOS-PS%20Eng.pdf</oboInOwl:hasDbXref>
